# Server Environment
PORT=5000
NODE_ENV=production

# MongoDB Connection String (Atlas URI or Local)
# Format for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/stocklink?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/stocklink?retryWrites=true&w=majority

# JWT Secret (Generate a strong random 32+ character secret)
JWT_SECRET=your_super_secret_production_jwt_key_here

# Allowed Frontend URLs for CORS (comma-separated if multiple)
CLIENT_URL=https://your-stocklink-frontend.vercel.app,https://your-stocklink-frontend.netlify.app
